{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "伴奏歌词",
  "version": "0.2.1",
  "identifier": "io.github.dylantlwu.banzou",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "伴奏歌词",
        "width": 1100,
        "height": 720,
        "minWidth": 800,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Music",
    "shortDescription": "伴奏、歌词、录唱、修音、练声、直播",
    "externalBin": [
      "binaries/banzou-helper"
    ],
    "macOS": {
      "signingIdentity": "-",
      "hardenedRuntime": false
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlCREI1NDJDOTlDNDFCMzgKUldRNEc4U1pMRlRibTdzVUVCWEZCbnh1MEt4Yy9pTit3cEI3ZXZReWxjSEZDUGQ0K0RQNDlxeU4K",
      "endpoints": [
        "https://github.com/dylantlwu/banzou/releases/latest/download/latest.json"
      ]
    }
  }
}
